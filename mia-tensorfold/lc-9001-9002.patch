+
+
+def extra_stop(eos, model_dir):
+    """LimeChain patch 9002: stop tokens beyond config.json's eos_token_id. GLM-5.3 lists <|endoftext|>, <|user|> and
+    <|observation|>, but ends short exact-format replies with <|assistant|> and then writes a fake next turn.
+    TF_GLM_EXTRA_STOP (comma-separated special-token strings, default "<|assistant|>"; empty = off) adds them by
+    token id, plus generation_config.json's eos_token_id. Read on both ranks from the same files."""
+
+    import json as _json
+    import os as _os
+    from pathlib import Path as _Path
+
+    d = _Path(model_dir)
+    ids = list(eos)
+    try:
+        gen = _json.loads((d / "generation_config.json").read_text()).get("eos_token_id")
+        ids += [int(x) for x in (gen if isinstance(gen, list) else [gen] if gen is not None else [])]
+    except (OSError, ValueError):
+        pass
+    names = [x.strip() for x in _os.environ.get("TF_GLM_EXTRA_STOP", "<|assistant|>").split(",") if x.strip()]
+    if names:
+        table = {a["content"]: int(a["id"]) for a in _json.loads((d / "tokenizer.json").read_text()).get("added_tokens", [])}
+        for n in names:
+            if n not in table:
+                raise ValueError(f"TF_GLM_EXTRA_STOP: {n!r} is not a special token of this tokenizer")
+            ids.append(table[n])
+    return tuple(dict.fromkeys(ids))
