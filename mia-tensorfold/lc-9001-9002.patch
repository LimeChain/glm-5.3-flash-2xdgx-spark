diff --git a/families/glm5_next/cuda/lc_logprobs.py b/families/glm5_next/cuda/lc_logprobs.py
new file mode 100644
index 0000000..2f008ad
--- /dev/null
+++ b/families/glm5_next/cuda/lc_logprobs.py
@@ -0,0 +1,69 @@
+"""LimeChain patch 9001 for the multi-stream engine: raw log probabilities of accepted tokens on two ranks.
+
+Each rank holds half of the vocabulary's logits. ``rows`` reduces every row on each rank to its log-sum-exp, the
+chosen token's logit (when it is in this rank's half) and its top ``TOP`` logits, gathers that across the ranks in
+one exchange, and combines them exactly (log-sum-exp of the ranks' log-sum-exps). Temperature, top-k and top-p are
+not applied, as vLLM's default ``raw_logprobs``. It only reads logits; the sampled tokens are the sampler's.
+
+It is a collective: both ranks call it for the same rows in the same order (rank 1 learns which streams want
+log probabilities from the ADMIT message).
+"""
+
+from __future__ import annotations
+
+from typing import Sequence
+
+import numpy as np
+import torch
+
+TOP = 20
+
+
+@torch.no_grad()
+def rows(w, logits: torch.Tensor, chosen: Sequence[int]) -> list[tuple[float, list[tuple[int, float]]]]:
+    """[(logprob of chosen, [(token, logprob) x TOP, best first])] for each row of ``logits`` ([R, V/world])."""
+
+    R = int(logits.shape[0])
+    if R == 0:
+        return []
+    x = logits.float()
+    V = int(x.shape[1])
+    k = min(TOP, V)
+    lse = torch.logsumexp(x, dim=-1, keepdim=True)
+    tv, ti = torch.topk(x, k, dim=-1)
+    ti = (ti + w.vocab_offset).to(torch.int32)
+    c = torch.tensor([int(t) for t in chosen], dtype=torch.int64, device=x.device) - w.vocab_offset
+    inside = (c >= 0) & (c < V)
+    cv = x.gather(1, c.clamp(0, V - 1)[:, None])
+    cv = torch.where(inside[:, None], cv, torch.full_like(cv, float("-inf")))
+    packed = torch.cat([lse, cv, tv, ti.view(torch.float32)], dim=1).contiguous()
+    width = 2 + 2 * k
+    if w.comm is None:
+        world = 1
+        g = packed.view(1, R, width).cpu()
+    else:
+        world = w.world
+        buf = torch.empty((world * packed.numel(),), dtype=torch.float32, device=x.device)
+        w.comm.all_gather(packed.view(-1), buf)
+        g = buf.view(world, R, width).cpu()
+    lses = torch.logsumexp(g[:, :, 0].double(), dim=0)
+    cvs = g[:, :, 1].double().max(dim=0).values
+    vals = torch.cat([g[r, :, 2:2 + k] for r in range(world)], dim=1).double().numpy()
+    ids = torch.cat([g[r, :, 2 + k:].contiguous().view(torch.int32) for r in range(world)], dim=1).numpy()
+    out = []
+    for i in range(R):
+        order = np.lexsort((ids[i], -vals[i]))[:k]
+        z = float(lses[i])
+        tops = [(int(ids[i][j]), min(0.0, float(vals[i][j]) - z)) for j in order]
+        out.append((min(0.0, float(cvs[i]) - z), tops))
+    return out
+
+
+def record(probabilities, prompt_len: int, start: int, tokens: Sequence[int], got) -> None:
+    """Rank 0: rows ``got`` for the reply's tokens ``tokens``, which begin at reply index ``start``, into the
+    request's ``tensorfold.engine.probabilities.Probabilities`` (positions are absolute: prompt + reply index)."""
+
+    if probabilities is None or not tokens:
+        return
+    for i, (t, g) in enumerate(zip(tokens, got)):
+        probabilities.rows[prompt_len + start + i] = {"id": int(t), "logprob": g[0], "top": list(g[1])}
